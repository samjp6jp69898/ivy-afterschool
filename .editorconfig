# afterschool
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_style = space
indent_size = 4

[*.{ts,tsx,vue,js,json,yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[justfile]
indent_style = space
indent_size = 4

[*.sh]
indent_style = space
indent_size = 4

[*.toml]
indent_style = space
indent_size = 2
