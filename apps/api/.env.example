# apps/api 的環境變數範本（INFRA-006）。複製成 apps/api/.env 後依本機環境修改。
#
# env 只放「沒有它程式起不來」的基礎設施值與 secret（docs/architecture_decisions.md §4）。
# 營運參數（安親班名稱、營業時段、通知文案、LIFF ID、LINE channel token…）一律放 DB
# system_settings，由後台「系統設定」頁調整；不要為業務參數新增 env 變數。
# 可用的 key 恰好是下列八項，由 scripts/tests/test_env_examples.py 把關。

# 執行環境，允許值：development / test / production。
# 影響 debug 輸出、Swagger 是否開啟、cookie secure 旗標等。
APP_ENV=development

# 後端 DB 連線字串（SQLAlchemy + psycopg 格式）。
# 本機使用後端專用角色 app_backend（DB-001 建立，不帶 BYPASSRLS），本機密碼由 seed 設定，
# 第一次連線前先 `just db-reset --yes`。
# 雲端改用 Supabase 的 Supavisor session pooler 連線字串（見 docs/deployment.md）。
DATABASE_URL=postgresql+psycopg://app_backend:app_backend_local@127.0.0.1:54342/postgres

# JWT 簽章金鑰，同時衍生 DB 內 secret（LINE channel token 等）的對稱加密金鑰。
# 至少 32 bytes，產生方式：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# 輪替會讓所有登入立即失效，且 DB 內已加密的 secret 需要重新加密（先解密再以新金鑰寫回）。
APP_SECRET_KEY=change-me

# 允許的 CORS 來源，逗號分隔、不含空白；本機是 Vite dev server（5341）。
# 正式環境前後端同源時留空（不送 CORS 標頭）。
CORS_ORIGINS=http://127.0.0.1:5341,http://localhost:5341

# 對外網址（不含結尾斜線），用於 LINE 通知內的連結與 LIFF 導回。
PUBLIC_BASE_URL=http://127.0.0.1:5341

# Supabase API 位址，供 Storage 操作（請假附件、學生照片）與簽發短效 URL。
# 本機是 Supabase CLI 的 API port 54341；雲端填專案 URL（https://<ref>.supabase.co）。
SUPABASE_URL=http://127.0.0.1:54341

# Storage 用的 service_role key（secret，只在後端使用，絕不下放前端）。
# 本機值取自 `supabase status -o env` 的 SERVICE_ROLE_KEY（INFRA-015 的 just bootstrap 會自動填入）。
# public schema 對 service_role 的權限已全部收回（DB-001），這把 key 只能操作 Storage。
SUPABASE_SERVICE_ROLE_KEY=change-me

# Sentry DSN，留空即停用錯誤回報。
SENTRY_DSN=
